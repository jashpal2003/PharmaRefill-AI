# =================================================================
# RxTriage AI — Environment Configuration Template
# Copy to .env and fill in. Never commit real keys.
# =================================================================

# AssemblyAI Speech-to-Text + LLM Gateway (SOAP notes / call audits)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# Any model your AssemblyAI LLM Gateway plan includes (e.g. a Claude model on paid plans)
LLM_MODEL=qwen3.5-4b-32k-fast

# Cartesia Sonic-2 TTS
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=47c38ca4-5f35-497b-b1a3-415245fb35e1

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15550190000

# Security
# role:token pairs. Leave empty ONLY for local development.
RXTRIAGE_AUTH_TOKENS=admin:change-me-admin,pharmacist:change-me-rph,technician:change-me-tech
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database / server
DB_PATH=pharma_records.db
HOST=127.0.0.1
PORT=8000
