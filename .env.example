# =================================================================
# PharmaRefill AI (RxTriage) — Environment Configuration Template
# =================================================================

# AssemblyAI Speech-to-Text & LeMUR Clinical Intelligence
# Get your API key at: https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Cartesia Sonic Low-Latency TTS (<150ms)
# Get your API key at: https://play.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here

# Twilio Telephony & Dual-Channel SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15550190000

# Database Configuration
DB_PATH=pharma_records.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
